print "== methods ==";

class Person {
  init(name) {
    this.name = name;
  }

  greet(prefix) {
    print prefix + this.name;
  }

  getName() {
    return this.name;
  }

  rename(name) {
    this.name = name;
    return this;
  }

  makeGreeter() {
    fun closure() {
      print this.name;
    }
    return closure;
  }
}

var alice = Person("Alice");
var bob = Person("Bob");

alice.greet("Hello ");
// expect: Hello Alice

bob.greet("Hello ");
// expect: Hello Bob

print alice.getName();
// expect: Alice


print "== this and mutation ==";

alice.rename("Aeris").greet("Now ");
// expect: Now Aeris

print alice.name;
// expect: Aeris


print "== bound method ==";

var greet = alice.greet;

greet("Bound ");
// expect: Bound Aeris

alice = Person("Replacement");

greet("Still ");
// expect: Still Aeris


print "== closure captures this ==";

var closure = bob.makeGreeter();

bob = nil;

closure();
// expect: Bob


print "== field shadows method ==";

class Shadow {
  thing() {
    print "method";
  }
}

fun replacement() {
  print "field";
}

var shadow = Shadow();

shadow.thing();
// expect: method

shadow.thing = replacement;
shadow.thing();
// expect: field


print "== initializer ==";

class Box {
  init(value) {
    this.value = value;
    return;
  }
}

var box = Box(42);

print box;
// expect: Box instance

print box.value;
// expect: 42


print "== class without initializer ==";

class Empty {}

print Empty();
// expect: Empty instance


print "== DONE ==";