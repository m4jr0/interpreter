/*
 * JLox - Chapter 8: Statements and State
 *
 * Tests:
 * - variable declarations
 * - variable lookup
 * - assignment
 * - chained assignment
 * - expression statements
 * - print statements
 * - blocks
 * - lexical scope
 * - shadowing
 */

var global = "global";

print global;

var a = 1;
var b = 2;

a = b = 42;

print a;
print b;

{
    var global = "inner";

    print global;

    var local = "only inside";
    print local;

    {
        var global = "very inner";
        print global;
    }

    print global;
}

print global;